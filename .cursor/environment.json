{
  "install": "bash .cursor/install.sh && git rev-parse HEAD",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "dev",
      "command": "export PATH=\"$HOME/.bun/bin:$PATH\"; bun run dev",
      "description": "Runs the API server (3000), web app (3001), and docs (4000) in development mode."
    }
  ],
  "ports": [
    { "name": "api", "port": 3000 },
    { "name": "web", "port": 3001 },
    { "name": "docs", "port": 4000 }
  ]
}
