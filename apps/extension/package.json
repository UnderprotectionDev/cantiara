{
  "name": "extension",
  "version": "0.0.0",
  "private": true,
  "description": "manifest.json description",
  "type": "module",
  "scripts": {
    "build": "tsc -b ../../packages/api && wxt build",
    "build:firefox": "wxt build -b firefox",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "tsc -b ../../packages/api && tsc --noEmit",
    "dev": "wxt --port 5555",
    "dev:firefox": "wxt -b firefox",
    "postinstall": "wxt prepare",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox"
  },
  "dependencies": {
    "@cantiara/api": "workspace:*",
    "@cantiara/ui": "workspace:*",
    "@tanstack/pacer-lite": "0.3.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "5.108.0",
    "@tanstack/react-store": "0.11.2",
    "date-fns": "^4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "tailwindcss": "catalog:",
    "typescript": "^5.9.3",
    "web-ext": "10.8.0",
    "wxt": "0.21.5"
  }
}
