{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@cantiara/api": "workspace:*",
    "@cantiara/auth": "workspace:*",
    "@cantiara/db": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@t3-oss/env-core": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.2",
    "evlog": "^2.28.1",
    "hono": "^4.13.7",
    "ipaddr.js": "^1.9.1",
    "undici": "^7.29.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cantiara/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
