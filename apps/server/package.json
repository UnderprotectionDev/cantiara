{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@cantiara/api": "workspace:*",
    "@cantiara/auth": "workspace:*",
    "@cantiara/db": "workspace:*",
    "@cantiara/env": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:",
    "diff": "^9.0.0",
    "dotenv": "catalog:",
    "evlog": "^2.22.4",
    "file-type": "^21.3.3",
    "hono": "catalog:",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.5.0",
    "papaparse": "^5.7.0",
    "sharp": "^0.35.4",
    "undici": "6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cantiara/config": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@types/bun": "catalog:",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.15.6",
    "pg": "^8.16.3",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  }
}
