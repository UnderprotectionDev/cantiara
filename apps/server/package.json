{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun --env-file=.env.local scripts/dev-server.ts",
    "start": "bun scripts/verify-eu-deployment.ts && bun run dist/index.mjs",
    "start:egress": "bun --no-env-file dist/smart-link-egress.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@cantiara/api": "workspace:*",
    "@cantiara/auth": "workspace:*",
    "@cantiara/db": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@t3-oss/env-core": "catalog:",
    "@tanstack/markdown": "1.2.0",
    "better-auth": "catalog:",
    "canonicalize": "^5.1.0",
    "drizzle-orm": "0.45.4",
    "evlog": "2.35.1",
    "file-type": "22.3.0",
    "hono": "4.13.19",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "mermaid": "12.3.0",
    "octokit": "^5.0.5",
    "papaparse": "5.7.1",
    "pdfjs-dist": "6.5.438",
    "pg-boss": "12.38.2",
    "playwright": "1.65.1",
    "sharp": "0.35.5",
    "undici": "7.30.2",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cantiara/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/papaparse": "5.5.2",
    "tsdown": "0.23.7",
    "typescript": "catalog:"
  }
}
