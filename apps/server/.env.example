NODE_ENV=development
PORT=3000
BETTER_AUTH_SECRET=generate-a-random-secret
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
CANTIARA_DESKTOP_API_CURRENT_CONTRACT=cantiara-desktop-api/v2
CANTIARA_DESKTOP_API_PREVIOUS_CONTRACT=cantiara-desktop-api/v1
CANTIARA_DESKTOP_API_PUBLISHED_AT=2026-08-26T00:00:00.000Z
DATABASE_URL=postgresql://owner:password@ep-example.neon.tech/neondb
NEON_LOCAL=false
# Development can keep security events in a separate local PostgreSQL database.
SECURITY_EVENT_LOCAL=true
SECURITY_EVENT_DATABASE_URL=postgresql://local-user@127.0.0.1:5432/cantiara_security
# Production requires a separate managed security-event PostgreSQL project.
GITHUB_CLIENT_ID=github-oauth-client-id
GITHUB_CLIENT_SECRET=github-oauth-client-secret
# Development uses a process-local File Attachment object store when these are empty;
# production requires R2 for Capture screenshot staging and File Attachments.
R2_ACCESS_KEY_ID=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_SECRET_ACCESS_KEY=
# Comma-separated IP addresses or CIDR ranges for the reverse proxies that append X-Forwarded-For.
TRUSTED_PROXY_IPS=203.0.113.10
