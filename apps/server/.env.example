# PostgreSQL connection string. Use sslmode=require for hosted providers such as Neon.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Set to true only when tunneling the Neon serverless driver to local Postgres
# via `scripts/neon-local-proxy.ts`. Leave unset when DATABASE_URL is hosted Neon.
# NEON_LOCAL=true

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
GITHUB_CLIENT_ID=github-oauth-app-client-id
GITHUB_CLIENT_SECRET=github-oauth-app-client-secret
NODE_ENV=development
