NODE_ENV=development
BETTER_AUTH_SECRET=generate-a-random-secret
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://user:password@localhost:5432/cantiara
# Set to true when scripts/neon-local-proxy.ts fronts a local PostgreSQL server.
NEON_LOCAL=false
# Must use credentials for a PostgreSQL project outside the primary restore unit.
SECURITY_EVENT_DATABASE_URL=postgresql://security:security-password@localhost:5432/cantiara_security
GITHUB_CLIENT_ID=github-oauth-client-id
GITHUB_CLIENT_SECRET=github-oauth-client-secret
# Comma-separated IP addresses or CIDR ranges for the reverse proxies that append X-Forwarded-For.
TRUSTED_PROXY_IPS=203.0.113.10
