NODE_ENV=development
PORT=3000
BETTER_AUTH_SECRET=generate-a-random-secret
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
CANTIARA_DESKTOP_API_CURRENT_CONTRACT=cantiara-desktop-api/v2
CANTIARA_DESKTOP_API_PREVIOUS_CONTRACT=cantiara-desktop-api/v1
CANTIARA_DESKTOP_API_PUBLISHED_AT=2026-08-26T00:00:00.000Z
DATABASE_URL=postgresql://owner:primary-password@ep-example.neon.tech/neondb
NEON_LOCAL=false
# Use a separate Neon project and credentials for security events.
SECURITY_EVENT_LOCAL=false
SECURITY_EVENT_DATABASE_URL=postgresql://security-owner:security-password@ep-security-example.neon.tech/neondb
GITHUB_CLIENT_ID=github-oauth-client-id
GITHUB_CLIENT_SECRET=github-oauth-client-secret
# Development uses a process-local File Attachment object store when these are empty;
# production requires R2 for Capture screenshot staging and File Attachments.
R2_ACCESS_KEY_ID=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_SECRET_ACCESS_KEY=
# Static SQL validation creates one disposable database per run in this dedicated Neon
# branch (PostgreSQL 17, never the product database) and drops it afterwards.
# Leave all three empty to keep Statically Validated unavailable.
NEON_API_KEY=
NEON_VALIDATION_PROJECT_ID=
NEON_VALIDATION_BRANCH_ID=
# Comma-separated IP addresses or CIDR ranges for the reverse proxies that append X-Forwarded-For.
TRUSTED_PROXY_IPS=203.0.113.10

# HTTPS /preview endpoint of the separately deployed, credential-free egress service.
# Unset keeps smart links as plain links; never point at the product API.
# SMART_LINK_EGRESS_URL=https://your-isolated-egress-service/preview
