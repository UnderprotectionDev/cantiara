{
  "name": "cantiara",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "@t3-oss/env-core": "^0.13.11",
      "@orpc/server": "^1.15.0",
      "@orpc/openapi": "^1.15.0",
      "@orpc/zod": "^1.15.0",
      "better-auth": "1.7.3",
      "lucide-react": "^1.41.0",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@orpc/client": "^1.15.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check": "bun run check:ultracite",
    "check:ultracite": "bunx --bun ultracite check",
    "check-types": "turbo run check-types && tsc --project scripts/tsconfig.json",
    "db:check": "bun run --cwd packages/db db:check",
    "db:development:bootstrap": "bun scripts/conductor-workspace.ts bootstrap",
    "db:development:promote": "bun scripts/conductor-workspace.ts promote",
    "db:doctor": "bun --env-file=apps/server/.env.local packages/db/scripts/doctor.ts",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:push": "bun run --cwd packages/db db:push",
    "db:security:generate": "bun run --cwd packages/db db:security:generate",
    "db:security:migrate": "bun run --cwd packages/db db:security:migrate",
    "db:studio": "bun run --cwd packages/db db:studio",
    "db:test": "vitest run packages/db/scripts scripts/dev-database-mode.test.ts scripts/local-dev-command.test.ts scripts/development-session.test.ts scripts/workspace-database.test.ts scripts/workspace-lifecycle.test.ts scripts/neon-api.test.ts scripts/migration-baseline.test.ts",
    "db:workspace:archive": "bun scripts/conductor-workspace.ts archive",
    "db:workspace:setup": "bun scripts/conductor-workspace.ts setup",
    "dev": "bun --env-file=apps/server/.env.local scripts/local-dev.ts",
    "dev:server": "bun --env-file=apps/server/.env.local scripts/local-dev.ts server",
    "dev:types": "tsc -b packages/api --watch",
    "dev:web": "turbo run dev -F web --",
    "fix:ultracite": "bunx --bun ultracite fix",
    "postinstall": "tsc -b packages/api && bun scripts/install-hooks.ts",
    "test:e2e": "bun run --cwd apps/web test:e2e"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@cantiara/config": "workspace:*",
    "@types/bun": "catalog:",
    "lefthook": "2.1.14",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.12.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "bun@1.3.13"
}
