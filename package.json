{
  "name": "cantiara",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.14",
      "hono": "^4.12.32",
      "@orpc/server": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "better-auth": "1.6.27",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@orpc/client": "^1.14.12",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev -F web -F server -F fumadocs -F @cantiara/db",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @cantiara/db --",
    "db:studio": "turbo run db:studio -F @cantiara/db --",
    "db:generate": "turbo run db:generate -F @cantiara/db --",
    "db:migrate": "turbo run db:migrate -F @cantiara/db --",
    "db:migrate:deploy": "turbo run db:migrate:deploy -F @cantiara/db --",
    "db:seed-founder-projects": "bun run --cwd apps/server src/features/project-shell/server/seed-founder-projects.ts",
    "seed": "bun run scripts/seed/run.ts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "turbo run test --concurrency=1"
  },
  "devNotes": {
    "wxt": "WXT extension development is intentionally excluded from bun run dev for now. TODO: Re-enable WXT in the default development workflow later."
  },
  "dependencies": {
    "@cantiara/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@cantiara/config": "workspace:*",
    "@types/bun": "catalog:",
    "lefthook": "latest",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "ultracite": "7.9.4"
  },
  "packageManager": "bun@1.3.13"
}
