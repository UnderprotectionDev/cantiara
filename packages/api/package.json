{
  "name": "@cantiara/api",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@cantiara/auth": "workspace:*",
    "@cantiara/db": "workspace:*",
    "@orpc/server": "catalog:",
    "canonicalize": "^5.1.0",
    "date-fns": "^4.4.0",
    "diff": "9.0.0",
    "drizzle-orm": "0.45.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cantiara/config": "workspace:*",
    "typescript": "catalog:"
  }
}
