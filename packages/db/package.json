{
  "name": "@cantiara/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "prisma db push",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "postinstall": "bunx --bun prisma generate",
    "db:studio": "prisma studio",
    "test": "bun test src"
  },
  "dependencies": {
    "@cantiara/env": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "catalog:",
    "pg": "^8.16.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cantiara/config": "workspace:*",
    "@types/pg": "^8.15.6",
    "prisma": "^7.9.1",
    "typescript": "catalog:"
  }
}
