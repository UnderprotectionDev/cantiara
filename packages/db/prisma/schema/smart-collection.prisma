model SmartCollection {
  id              String    @id
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  sourceKind      String
  conditions      Json
  revision        Int
  subscribeOnEntry Boolean  @default(false)
  subscribeOnExit  Boolean  @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  membershipPeriods SmartCollectionMembershipPeriod[]
  attentionSignals  SmartCollectionAttentionSignal[]

  @@index([workspaceId])
  @@index([projectId])
  @@map("smart_collection")
}

model SmartCollectionMembershipPeriod {
  id           String          @id
  collectionId String
  collection   SmartCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recordId     String
  recordKind   String
  open         Boolean
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([collectionId])
  @@index([collectionId, recordId])
  @@map("smart_collection_membership_period")
}

model SmartCollectionAttentionSignal {
  id           String          @id
  collectionId String
  collection   SmartCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recordId     String
  recordKind   String
  signalId     String
  section      String
  phase        String
  reason       String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([collectionId])
  @@map("smart_collection_attention_signal")
}
