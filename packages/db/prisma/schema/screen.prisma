model Screen {
  id         String             @id
  projectId  String
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  archivedAt DateTime?
  trashedAt  DateTime?
  revision   Int
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  versions   WireframeVersion[]
  events     ScreenEvent[]

  @@index([projectId])
  @@index([projectId, trashedAt, archivedAt])
  @@map("screen")
}

model WireframeVersion {
  id            String   @id
  screenId      String
  screen        Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  versionNumber Int
  document      Json
  createdAt     DateTime @default(now())

  @@unique([screenId, versionNumber])
  @@index([screenId])
  @@map("wireframe_version")
}

model ScreenEvent {
  id        String   @id
  screenId  String
  screen    Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  kind      String
  actorId   String
  occurredAt DateTime @default(now())

  @@index([screenId, occurredAt])
  @@map("screen_event")
}
