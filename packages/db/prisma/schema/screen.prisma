model Screen {
  id                        String             @id
  projectId                 String
  project                   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                     String
  body                      String             @default("")
  archivedAt                DateTime?
  trashedAt                 DateTime?
  redactedAt                DateTime?
  currentWireframeVersionId String?
  wireframeVersionsJson     String             @default("[]")
  revision                  Int
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  versions                  WireframeVersion[]
  events                    ScreenEvent[]
  personalViewports         ScreenPersonalViewport[]

  @@index([projectId])
  @@index([projectId, archivedAt])
  @@index([projectId, trashedAt])
  @@index([projectId, trashedAt, archivedAt])
  @@map("screen")
}

model WireframeVersion {
  id            String   @id
  screenId      String
  screen        Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  versionNumber Int
  document      Json
  createdAt     DateTime @default(now())

  @@unique([screenId, versionNumber])
  @@index([screenId])
  @@map("wireframe_version")
}

model ScreenEvent {
  id         String   @id
  screenId   String
  screen     Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  kind       String
  actorId    String
  occurredAt DateTime @default(now())

  @@index([screenId, occurredAt])
  @@map("screen_event")
}

model WireframeLinkedBlock {
  id         String   @id
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  definition Json
  revision   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId])
  @@map("wireframe_linked_block")
}

model ScreenPersonalViewport {
  id                String   @id
  screenId          String
  screen            Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  centerX           Float
  centerY           Float
  zoom              Float
  collapsedGroupIds Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([screenId, userId])
  @@index([userId])
  @@map("screen_personal_viewport")
}
