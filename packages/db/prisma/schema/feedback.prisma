model Feedback {
  id              String               @id
  projectId       String
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originalMessage String
  channel         String
  occurredAt      DateTime
  url             String?
  status          String
  revision        Int
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  events          FeedbackEvent[]
  attachments     FeedbackAttachment[]
  evidenceLinks   FeedbackEvidenceLink[]

  @@index([projectId])
  @@index([projectId, status])
  @@map("feedback")
}

model FeedbackEvent {
  id             String    @id
  feedbackId     String
  feedback       Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  kind           String
  actorId        String
  previousStatus String?
  nextStatus     String
  occurredAt     DateTime  @default(now())

  @@index([feedbackId, occurredAt])
  @@map("feedback_event")
}

model FeedbackAttachment {
  id               String   @id
  feedbackId       String
  feedback         Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  fileAttachmentId String
  createdAt        DateTime @default(now())

  @@index([feedbackId])
  @@map("feedback_attachment")
}

model FeedbackEvidenceLink {
  id                      String    @id
  relationId              String    @unique
  feedbackId              String
  feedback                Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  workId                  String
  work                    Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  reportedProblem         String    @default("")
  suggestedSolution       String    @default("")
  currentWorkaround       String    @default("")
  impactSeverity          String    @default("")
  usageFrequency          String    @default("")
  independence            String    @default("")
  audienceFit             String    @default("")
  evidenceRole            String    @default("Unspecified")
  followUp                String?
  interpretationActorId   String?
  interpretationSetAt     DateTime?
  revision                Int
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([feedbackId, workId])
  @@index([feedbackId])
  @@index([workId])
  @@map("feedback_evidence_link")
}
