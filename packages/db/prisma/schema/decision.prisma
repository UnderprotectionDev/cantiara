model Decision {
  id                  String           @id
  projectId           String
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title               String
  decisionText        String
  rationale           String
  life                String
  withdrawnAt         DateTime?
  withdrawnRationale  String?
  revision            Int
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  events              DecisionEvent[]

  @@index([projectId])
  @@index([projectId, life])
  @@map("decision")
}

model DecisionEvent {
  id           String   @id
  decisionId   String
  decision     Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  kind         String
  actorId      String
  rationale    String?
  previousLife String?
  nextLife     String
  occurredAt   DateTime @default(now())

  @@index([decisionId, occurredAt])
  @@map("decision_event")
}
