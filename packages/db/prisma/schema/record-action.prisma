model RecordAction {
  id         String    @id
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  steps      Json
  targetKind String
  trashedAt  DateTime?
  revision   Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([projectId])
  @@index([projectId, trashedAt])
  @@map("record_action")
}
