model CaptureInboxItem {
  id                     String                 @id
  workspaceId            String
  ownerId                String
  projectId              String?
  body                   String                 @default("")
  template               String?
  fieldsText             String                 @default("{}")
  link                   String                 @default("")
  attachmentRef          String?
  origin                 String                 @default("")
  capturedAt             DateTime
  consumedAt             DateTime?
  consumedExit           String?
  consumedTargetId       String?
  consumedTargetKind     String?
  consumedRelation       String?
  consumedAttributedText String                 @default("{}")
  stagingCleanupStatus   String?
  stagingCleanupError    String?
  stagingCleanupAt       DateTime?
  consumedMergeId        String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  staging                CaptureStagingObject?

  @@index([workspaceId, projectId, capturedAt])
  @@index([workspaceId, consumedMergeId])
  @@map("capture_inbox_item")
}

model CaptureBulkSenseView {
  id          String   @id
  workspaceId String
  ownerId     String
  layoutText  String   @default("{\"clusters\":[],\"placements\":[]}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, ownerId])
  @@map("capture_bulk_sense_view")
}

model CaptureExtensionLink {
  id          String    @id
  workspaceId String
  ownerId     String
  tokenHash   String    @unique
  device      String
  browser     String
  family      String
  lastUsedAt  DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, ownerId])
  @@map("capture_extension_link")
}

model CapturePairingCode {
  id          String    @id
  workspaceId String
  ownerId     String
  codeHash    String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, ownerId])
  @@map("capture_pairing_code")
}

model CaptureStagingObject {
  id          String           @id
  inboxItemId String           @unique
  item        CaptureInboxItem @relation(fields: [inboxItemId], references: [id], onDelete: Cascade)
  workspaceId String
  filename    String
  contentType String
  byteLength  Int
  keyVersion  Int
  wrappedDek  Bytes
  ciphertext  Bytes
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([workspaceId])
  @@map("capture_staging_object")
}
