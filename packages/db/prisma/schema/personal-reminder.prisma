model PersonalReminder {
  id              String   @id
  accountId       String
  account         User     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fireAt          DateTime
  sourceType      String
  sourceId           String
  createdByAction    String
  documentSectionId  String?
  stillOpenCondition String
  life               String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId])
  @@index([accountId, life])
  @@index([accountId, sourceType, sourceId])
  @@map("personal_reminder")
}
