model Work {
  id        String   @id
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  number    Int
  title     String
  type      String
  status    String
  revision  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, number])
  @@unique([projectId, key])
  @@index([projectId])
  @@map("work")
}

model ProjectWorkKeyCounter {
  projectId  String  @id
  nextNumber Int
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_work_key_counter")
}
