model Source {
  id                     String          @id
  projectId              String
  project                Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvedVersionNumber  Int
  revision               Int
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  versions               SourceVersion[]

  @@index([projectId])
  @@map("source")
}

model SourceVersion {
  id                 String   @id
  sourceId           String
  source             Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  versionNumber      Int
  url                String
  title              String
  accessedAt         DateTime
  capturedContent    String
  excerpt            String
  provider           String?
  externalRecordType String?
  externalId         String?
  createdAt          DateTime @default(now())

  @@unique([sourceId, versionNumber])
  @@index([sourceId])
  @@map("source_version")
}
