model MutationFixtureRecord {
  id        String               @id
  value     String
  revision  Int
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  history   RecordHistoryEntry[]

  @@map("mutation_fixture_record")
}

model MutationReceipt {
  id                 String   @id
  commandKey         String   @unique
  actorType          String
  actorId            String
  origin             String
  targetId           String
  payloadFingerprint String
  committedRevision  Int
  resultValue        String
  kind               String   @default("commit")
  createdAt          DateTime @default(now())

  @@index([targetId])
  @@map("mutation_receipt")
}

model RecordHistoryEntry {
  id            String                 @id
  targetId      String
  target        MutationFixtureRecord  @relation(fields: [targetId], references: [id], onDelete: Cascade)
  actorType     String
  actorId       String
  origin        String
  occurredAt    DateTime
  previousValue String
  nextValue     String
  revisionAfter Int

  @@index([targetId, occurredAt])
  @@map("record_history_entry")
}

model MutationStagingOperation {
  id                 String   @id
  commandKey         String   @unique
  actorId            String
  origin             String
  targetId           String
  baseRevision       Int
  payloadFingerprint String
  payloadJson        String
  targetScope        String
  status             String
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status, expiresAt])
  @@map("mutation_staging_operation")
}

model MutationFixtureRelation {
  id        String   @id
  sourceId  String
  targetId  String
  kind      String
  createdAt DateTime @default(now())

  @@index([sourceId])
  @@map("mutation_fixture_relation")
}

model MutationFixtureCounter {
  id        String   @id
  targetId  String   @unique
  value     Int
  updatedAt DateTime @updatedAt

  @@map("mutation_fixture_counter")
}

model MutationFixtureIndexEntry {
  id        String   @id
  targetId  String
  token     String
  createdAt DateTime @default(now())

  @@unique([targetId, token])
  @@map("mutation_fixture_index_entry")
}
