model MutationFixtureRecord {
  id        String               @id
  value     String
  revision  Int
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  history   RecordHistoryEntry[]

  @@map("mutation_fixture_record")
}

model MutationReceipt {
  id                 String   @id
  commandKey         String   @unique
  actorType          String
  actorId            String
  origin             String
  targetId           String
  payloadFingerprint String
  committedRevision  Int
  resultValue        String
  createdAt          DateTime @default(now())

  @@index([targetId])
  @@map("mutation_receipt")
}

model RecordHistoryEntry {
  id            String                 @id
  targetId      String
  target        MutationFixtureRecord  @relation(fields: [targetId], references: [id], onDelete: Cascade)
  actorType     String
  actorId       String
  origin        String
  occurredAt    DateTime
  previousValue String
  nextValue     String
  revisionAfter Int

  @@index([targetId, occurredAt])
  @@map("record_history_entry")
}
