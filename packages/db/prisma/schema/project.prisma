model Project {
  id                              String                       @id
  workspaceId                     String
  workspace                       Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                            String
  shortCode                       String
  lifecycleStatus                 String
  starterConfiguration            String
  purpose                         String?
  problem                         String?
  scope                           String?
  targetDate                      String?
  logoFileName                    String?
  hasWork                         Boolean                      @default(false)
  firstOpenExplanationDismissed   Boolean                      @default(false)
  focusThreshold                  Int?
  reappearDateNotification        Boolean                      @default(false)
  revision                        Int
  createdAt                       DateTime                     @default(now())
  updatedAt                       DateTime                     @updatedAt
  stages                          ProjectStage[]
  areaSettings                    ProjectAreaSetting[]
  skeletonSelections              ProjectSkeletonSelection[]
  workViews                       ProjectWorkView[]
  workStatuses                    ProjectWorkStatus[]
  works                           Work[]
  workKeyCounter                  ProjectWorkKeyCounter?
  customFieldDefinitions          ProjectCustomFieldDefinition[]
  priorityCriterionDefinitions    ProjectPriorityCriterion[]
  priorityMapPresentation         ProjectPriorityMapPresentation?
  prioritizationSessions          PrioritizationSession[]
  fileAttachments                 FileAttachment[]
  documents                       Document[]
  workContextCardLayouts          ProjectWorkContextLayout[]
  workTemplates                   WorkTemplate[]
  recordActions                   RecordAction[]
  backlogManualOrderItems         ProjectBacklogManualOrderItem[]
  backlogPresentation             ProjectBacklogPresentation?
  roadmapNamedViews               ProjectRoadmapNamedView[]
  milestones                      Milestone[]

  @@index([workspaceId])
  @@map("project")
}

model ProjectStage {
  id        String   @id
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  state     String
  sortOrder Int
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("project_stage")
}

model ProjectAreaSetting {
  id        String   @id
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  enabled   Boolean
  pinned    Boolean
  pinOrder  Int?
  createdAt DateTime @default(now())

  @@unique([projectId, name])
  @@map("project_area_setting")
}

model ProjectWorkView {
  id        String   @id
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int
  createdAt DateTime @default(now())

  @@unique([projectId, name])
  @@map("project_work_view")
}

model ProjectSkeletonSelection {
  id            String   @id
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  surface       String
  emptyHeadings String[]
  sortOrder     Int
  createdAt     DateTime @default(now())

  @@unique([projectId, name])
  @@index([projectId])
  @@map("project_skeleton_selection")
}

model ProjectWorkStatus {
  id           String   @id
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  semantic     String
  label        String
  sortOrder    Int
  softWipLimit Int?
  createdAt    DateTime @default(now())

  @@unique([projectId, semantic])
  @@map("project_work_status")
}

model WorkspaceShortCodeReservation {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  shortCode   String
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, shortCode])
  @@map("workspace_short_code_reservation")
}
