model Project {
  id                   String    @id
  workspaceId          String
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                 String
  shortCode            String
  lifecycleStatus      String
  starterConfiguration String
  purpose              String?
  problem              String?
  scope                String?
  targetDate           String?
  logoFileName         String?
  hasWork              Boolean   @default(false)
  revision             Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([workspaceId])
  @@map("project")
}

model WorkspaceShortCodeReservation {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  shortCode   String
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, shortCode])
  @@map("workspace_short_code_reservation")
}
