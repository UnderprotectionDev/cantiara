model Contact {
  id                    String                       @id
  workspaceId           String
  workspace             Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  displayName           String
  retiredIntoId         String?
  retiredInto           Contact?                     @relation("ContactRetiredIdentity", fields: [retiredIntoId], references: [id], onDelete: SetNull)
  retiredIdentities     Contact[]                    @relation("ContactRetiredIdentity")
  revision              Int
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  emailAliases          ContactEmailAlias[]
  affiliations          ContactCompanyAffiliation[]
  mergeEventsAsSurvivor ContactMergeEvent[]          @relation("ContactMergeSurvivor")
  mergeEventsAsRetired  ContactMergeEvent[]          @relation("ContactMergeRetired")

  @@index([workspaceId])
  @@index([retiredIntoId])
  @@map("contact")
}

model ContactEmailAlias {
  id               String   @id
  contactId        String
  contact          Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  originalEmail    String
  normalizedEmail  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([contactId, normalizedEmail])
  @@index([normalizedEmail])
  @@map("contact_email_alias")
}

model Company {
  id            String                       @id
  workspaceId   String
  workspace     Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  revision      Int
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  affiliations  ContactCompanyAffiliation[]

  @@index([workspaceId])
  @@map("company")
}

model ContactCompanyAffiliation {
  id         String    @id
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  startedAt  DateTime
  endedAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([contactId, endedAt])
  @@index([companyId])
  @@map("contact_company_affiliation")
}

model ContactMergeEvent {
  id                String   @id
  survivorId        String
  survivor          Contact  @relation("ContactMergeSurvivor", fields: [survivorId], references: [id], onDelete: Cascade)
  retiredId         String
  retired           Contact  @relation("ContactMergeRetired", fields: [retiredId], references: [id], onDelete: Cascade)
  attributedFields  String
  previousSurvivor  String
  postMergeSurvivor String
  retiredSnapshot   String
  movedRelations    String
  createdAt         DateTime @default(now())

  @@index([survivorId])
  @@map("contact_merge_event")
}
