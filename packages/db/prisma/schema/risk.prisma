model Risk {
  id                    String      @id
  projectId             String
  project               Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                 String
  description           String
  impact                String
  probability           String
  response              String
  status                String
  acceptanceRationale   String?
  revision              Int
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  events                RiskEvent[]
  attentionSignals      RiskAttentionSignal[]
  relatedRecords        RiskRelatedRecord[]

  @@index([projectId])
  @@index([projectId, status])
  @@map("risk")
}

model RiskEvent {
  id             String   @id
  riskId         String
  risk           Risk     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  kind           String
  actorId        String
  rationale      String?
  previousStatus String?
  nextStatus     String
  occurredAt     DateTime @default(now())

  @@index([riskId, occurredAt])
  @@map("risk_event")
}

model RiskAttentionSignal {
  id               String   @id
  riskId           String
  risk             Risk     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  signalId         String
  section          String
  sourceEventId    String
  sourceEventKind  String
  impact           String
  probability      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([signalId, sourceEventId])
  @@index([riskId])
  @@map("risk_attention_signal")
}

model RiskRelatedRecord {
  id             String   @id
  riskId         String
  risk           Risk     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  targetKind     String
  targetId       String
  inPublishPrep  Boolean?
  releaseStatus  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([riskId, targetKind, targetId])
  @@index([riskId])
  @@map("risk_related_record")
}
