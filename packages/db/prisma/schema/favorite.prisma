model FavoriteMembership {
  id         String   @id
  accountId  String
  account    User     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sourceType String
  sourceId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([accountId, sourceType, sourceId])
  @@index([accountId])
  @@map("favorite_membership")
}
