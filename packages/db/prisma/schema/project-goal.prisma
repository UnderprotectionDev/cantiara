model ProjectGoal {
  id               String   @id
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  description      String
  intendedOutcome  String?
  observedOutcome  String?
  revision         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([projectId])
  @@map("project_goal")
}
