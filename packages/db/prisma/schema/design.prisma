model Design {
  id        String            @id
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  name      String
  revision  Int
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  cards     ProjectWallCard[]

  @@index([projectId, type])
  @@map("design")
}

model ProjectWallCard {
  id         String   @id
  designId   String
  design     Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  sourceId   String
  sourceKind String
  positionX  Float
  positionY  Float
  density    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([designId, sourceId])
  @@index([designId])
  @@index([sourceId])
  @@map("project_wall_card")
}
